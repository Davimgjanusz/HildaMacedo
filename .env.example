# ---------------------------------------------------------------------------
# Autenticação (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# Gere com: npx auth secret
AUTH_SECRET=""
# Necessário fora da Vercel (ex.: VPS, Docker) para confiar no host da requisição
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Santander — Cobrança (boletos) e Pix
# ---------------------------------------------------------------------------
# mock | sandbox | production
SANTANDER_ENV="mock"
SANTANDER_CLIENT_ID=""
SANTANDER_CLIENT_SECRET=""
# Workspace de cobrança criado no portal do desenvolvedor Santander
SANTANDER_WORKSPACE_ID=""
# Convênio / código do beneficiário
SANTANDER_COVENANT_CODE=""
# Chave Pix recebedora (CNPJ, e-mail, telefone ou aleatória)
SANTANDER_PIX_KEY=""
# Certificado mTLS (ICP-Brasil A1) em PEM, codificado em base64
SANTANDER_CERT_BASE64=""
SANTANDER_KEY_BASE64=""
# Segredo compartilhado validado no webhook de conciliação (/api/webhooks/santander)
SANTANDER_WEBHOOK_SECRET=""
